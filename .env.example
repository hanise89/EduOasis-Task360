# EDUOASIS TASK360 — Environment Variables
#
# This project uses Supabase (PostgreSQL) as its database.
# Create a Supabase project at https://supabase.com and fill in the values below.

# Primary database URL — Supavisor connection pooler in SESSION mode (port 5432).
# Works for both Prisma migrations AND application runtime.
# Format: postgresql://postgres.{PROJECT_REF}:{PASSWORD}@aws-0-{REGION}.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres"

# Direct connection (IPv6, session mode) — admin only, not used by the app
# Format: postgresql://postgres:{PASSWORD}@db.{PROJECT_REF}.supabase.co:5432/postgres
DIRECT_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase project metadata
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PROJECT_REF="YOUR_PROJECT_REF"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
